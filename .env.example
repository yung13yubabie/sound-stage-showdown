# Example only. Never put a service-role key in a VITE_ variable.
# Copy to .env.local for local overrides, then supply your own public project values.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key

# Server-only admin credentials, if needed, belong in the hosting provider's
# secret settings. Never add their real values to this file or tracked .env.
